# ─────────────────────────────────────────────────────────────
#  MODÈLE de configuration — copier ce fichier en « .env » et remplir.
#     Windows PowerShell :  Copy-Item .env.example .env
#     macOS / Linux      :  cp .env.example .env
#
#  Le vrai fichier .env n'est JAMAIS versionné (voir .gitignore).
#  Ne mets jamais tes vraies clés ici : ce fichier-ci est public dans le repo.
#
#  IMPORTANT : l'application web (npm run dev) ne nécessite AUCUNE de ces
#  variables — elle tourne sur les données déjà présentes dans src/data/.
#  Elles ne servent QU'AU pipeline d'automatisation Python/PowerShell
#  (dossier automation/), qui est optionnel pour développer l'app.
# ─────────────────────────────────────────────────────────────

# --- Secrets : à générer sur TES propres comptes ---
GEMINI_API_KEY=            # Clé Google Gemini (agents d'intelligence)
TELEGRAM_BOT_TOKEN=        # Token du bot Telegram (notifications / digest)
TELEGRAM_CHAT_ID=          # ID du chat Telegram destinataire

# --- Configuration : valeurs d'exemple, à adapter ---
TARGET_COUNTRIES=Angola,Nigeria,Côte d'Ivoire,Mozambique,Namibie
TARGET_COMPANIES=TotalEnergies,Eni,Chevron,ExxonMobil,Perenco
REPORTS_DIR=reports
